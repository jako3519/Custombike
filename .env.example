# Kopiér til .env.local (git ignorerer den). Udfyld kun det, du skal bruge.
# Opret ikke Fly- eller Neon-ressourcer herfra, før du selv vælger det.

# Postgres. I drift (Neon) bruges DATABASE_URL. Til migrationer på Neon: den upoolede adresse.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Offentlig adresse. Tom = kanoniske links og sitemap bruger den vært, siden bliver åbnet på.
# Site__Url=https://custombike.example/
# Site__CanonicalHost=custombike.example
# Site__RedirectHosts=custombike.fly.dev

# Google-login til admin. Redirect-URI hos Google: https://<dit-domæne>/signin-google
# Lokalt: http://localhost:5248/signin-google
# GoogleOAuth__ClientId=
# GoogleOAuth__ClientSecret=
# Kun disse konti kan logge ind (står i koden, ikke her): Backend/Security/AdminWhitelist.cs

# Kontaktformularens mail. Uden disse gemmes henvendelsen, men der sendes ingen mail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=

# Google Tag Manager og Search Console. Tomt = ingen Google-tags.
# Analytics__GtmId=
# Site__GoogleSiteVerification=

# Kun til lokal Vite. I drift serverer backend selv frontenden.
# Frontend__Url=http://localhost:5173
